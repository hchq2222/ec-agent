# 复制为 .env 并填入真实值（.env 已被 gitignore）
OMYAI_API_KEY=
PLANNER_BASE_URL=
PLANNER_API_KEY=
PLANNER_MODEL=
# DeepSeek 文本模型（提示词生成 / 商品识别）；配置后优先于 PLANNER_*
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:8000
# 渠道 API Key 的加密密钥（自定一段随机字符串，生产用密钥管理）
CHANNEL_SECRET_KEY=

# PostgreSQL（为空则不落库）
DATABASE_URL=postgresql+asyncpg://app_user:<password>@203.0.113.10:5432/ec_agent_pro

# 产物存储：local（本地盘）| minio（S3 协议）
STORAGE_BACKEND=local
MINIO_ENDPOINT=https://203.0.113.10:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_ASSETS=assets
MINIO_REGION=us-east-1
# 自建 CA 的本地路径（仓库不附带证书；不需要时留空）
MINIO_CA_BUNDLE=
MINIO_PRESIGN_TTL=900
# presign（推荐生产）| proxy（开发免装私有 CA）
STORAGE_URL_MODE=proxy

# 可选
# OUTPUT_DIR=var/outputs
# PROVIDERS_CONFIG=config/providers.yaml
