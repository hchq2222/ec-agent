# 复制为 .env 并填入真实值（.env 已被 gitignore）
OMYAI_API_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:8000

# PostgreSQL（为空则不落库）
DATABASE_URL=postgresql+asyncpg://app_user:<password>@203.0.113.10:5432/ec_agent_pro

# 产物存储：local（本地盘）| minio（S3 协议）
STORAGE_BACKEND=local
MINIO_ENDPOINT=https://203.0.113.10:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_ASSETS=assets
MINIO_REGION=us-east-1
MINIO_CA_BUNDLE=infrastructure/certs/ca.crt
MINIO_PRESIGN_TTL=900

# 可选
# OUTPUT_DIR=var/outputs
# PROVIDERS_CONFIG=config/providers.yaml
